# ---------- database (docker compose) ----------
POSTGRES_USER=strategylab
POSTGRES_PASSWORD=CHANGE_ME_long_random_string
POSTGRES_DB=strategylab

# ---------- application ----------
SL_ENV=production
# Bearer token required for any API call that changes state. Generate: openssl rand -hex 32
SL_API_TOKEN=CHANGE_ME
SL_LOG_LEVEL=INFO
SL_LOG_JSON=true

# ---------- market data ----------
# simulated = deterministic synthetic prices (no key; good for testing the pipeline)
# twelvedata = real XAU/USD + NDX data from twelvedata.com (needs an API key)
SL_DATA_PROVIDER=simulated
SL_TWELVEDATA_API_KEY=
SL_GOLD_PROVIDER_SYMBOL=XAU/USD
SL_NASDAQ_PROVIDER_SYMBOL=NDX
SL_POLL_INTERVAL_SECONDS=20
SL_STALE_GRACE_SECONDS=120
SL_FEED_TIMEOUT_SECONDS=300

# ---------- notifications ----------
# Slack/Discord incoming-webhook URL, or any endpoint accepting JSON POST
SL_WEBHOOK_URL=
SL_SMTP_HOST=
SL_SMTP_PORT=587
SL_SMTP_USER=
SL_SMTP_PASSWORD=
SL_SMTP_FROM=
SL_NOTIFY_EMAIL_TO=
SL_ALERT_COOLDOWN_SECONDS=900
# External dead-man's switch pinged every 30s by the watchdog (e.g. https://hc-ping.com/<uuid>).
# Alerts you if the WHOLE host goes down — something the app cannot report itself.
SL_DEADMAN_URL=

# ---------- research ----------
SL_JOB_MAX_ATTEMPTS=3
WORKER_CPUS=1.0
SL_DETERIORATION_MIN_TRADES=10
SL_DETERIORATION_SHARPE_DROP=0.5
SL_DETERIORATION_MAX_DRAWDOWN_PCT=15

# ---------- backups ----------
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=14

# ---------- networking ----------
# 127.0.0.1 = only reachable through a reverse proxy on the same host (recommended)
API_BIND=127.0.0.1
